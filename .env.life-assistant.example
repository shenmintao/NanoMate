# Copy to .env.life-assistant and start with:
# docker compose --env-file .env.life-assistant -f docker-compose.life-assistant.yml up -d --build

TZ=Asia/Shanghai

# Pick one provider. DeepSeek is a China-friendly default.
NANOMATE_PROVIDER=deepseek
NANOMATE_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Alternative LLM providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=

# Generic override for the selected provider.
NANOMATE_PROVIDER_API_KEY=
NANOMATE_PROVIDER_API_BASE=

# Optional China life-service upgrades. Public no-registration providers stay enabled by default.
AMAP_KEY=
QWEATHER_KEY=
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# Optional web search provider key/base. Default search can use free public providers.
NANOMATE_WEB_SEARCH_PROVIDER=
NANOMATE_WEB_SEARCH_API_KEY=
NANOMATE_WEB_SEARCH_BASE_URL=

# Optional proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# Host ports.
NANOMATE_GATEWAY_HOST_PORT=18790
NANOMATE_WEBSOCKET_HOST_PORT=8765
NANOMATE_API_HOST_PORT=8900
NANOMATE_BRIDGE_HOST_PORT=3002

# Runtime defaults.
NANOMATE_BOT_NAME=NanoMate
NANOMATE_UNIFIED_SESSION=true
NANOMATE_RESTRICT_TO_WORKSPACE=true
NANOMATE_PUBLIC_PROVIDERS_ENABLED=true
NANOMATE_SILLYTAVERN_ENABLED=false
